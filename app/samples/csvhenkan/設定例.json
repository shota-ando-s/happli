{
  "app": "csvhenkan",
  "version": 1,
  "name": "受注データ→会計取込用",
  "columns": [
    { "name": "伝票番号", "source": "受注番号", "transform": "none" },
    { "name": "伝票日付", "source": "受注日", "transform": "digits" },
    { "name": "取引先名", "source": "顧客名", "transform": "none", "maxBytes": 20 },
    { "name": "取引先カナ", "source": "顧客名カナ", "transform": "hankaku", "maxBytes": 20 },
    { "name": "電話", "source": "電話番号", "transform": "digits" },
    { "name": "地域コード", "source": "都道府県", "transform": "none", "replace": [["北海道", "01"], ["東京", "13"], ["神奈川", "14"], ["愛知", "23"], ["京都", "26"], ["大阪", "27"]] },
    { "name": "数量", "source": "数量", "transform": "none" },
    { "name": "金額", "source": "金額", "transform": "amount" },
    { "name": "摘要", "concat": ["受注番号", "備考"], "sep": " ", "transform": "trim" },
    { "name": "取引区分", "fixed": "1", "transform": "none" }
  ],
  "output": { "header": true, "encoding": "SJIS", "filename": "会計取込用.csv" }
}
